<div class="container py-5" style="max-width: 600px;">
  <h1 class="fw-bold text-center mb-4">Stupid Coaching</h1>

  <div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
      <blockquote class="blockquote mb-0">
        <p><%= @question %></p>
        <footer class="blockquote-footer mt-1">You</footer>
      </blockquote>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4" style="background-color: #fff9db;">
    <div class="card-body">
      <blockquote class="blockquote mb-0">
        <p class="fw-semibold"><%= @answer %></p>
        <footer class="blockquote-footer mt-1">Your coach</footer>
      </blockquote>
    </div>
  </div>

  <div class="text-center">
    <%= link_to "← Ask another question", ask_path, class: "btn btn-outline-secondary" %>
  </div>
</div>
